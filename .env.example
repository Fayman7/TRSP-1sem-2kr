# Скопируйте в .env и задайте свои значения. Файл .env не коммитьте.
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

# Режим: dev | prod
MODE=dev

# Секрет для подписи cookie session_token (обязательно смените в продакшене)
SECRET_KEY=change-me-to-a-long-random-string

# Опционально: HTTP Basic для /docs и /redoc (оставьте пустым, чтобы отключить)
DOCS_USER=
DOCS_PASSWORD=
